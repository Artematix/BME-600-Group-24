# Raw datasets and team PDFs. Too big / not ours to publish.
Uncommitted Data/
Raw Data Dump/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Team-internal notes (draft critique, private links). Keep local.
docs/team-docs/
README_DRAFT.md

# FDA MAUDE robot downloads (large, re-creatable by the robot)
fda-maude/raw/
fda-maude/clean/

# Course PDFs and the instructor's documents. Keep local.
docs/rubrics/

# Change-notes version of the midterm plan (quotes team comments). Keep local.
docs/plans/2026-10-14_midterm-research-plan_change-notes.docx

# MAUDE flattened tables (large, re-creatable with the robot). Keep local.
fda-maude/data/*.parquet
fda-maude/data/*.jsonl

# Preprocessed parquet cache (rebuilt by analysis/preprocess.py)
analysis/cache/

# Keep the small pilot sample (287 reports) as a test fixture
!fda-maude/data/sample_narratives.jsonl

# Pilot model outputs on the sample (re-creatable; the validation rests on the gold v2/v3 runs, which stay)
fda-maude/results/text/llm_sample_*.jsonl
fda-maude/results/text/llm_serious500_*

# One row per trial participant. Keep local (rebuilt by subgroups.py and simulation_v2.py).
analysis/participant_metrics.csv
analysis/simulation_v2_participants.csv

# Course documents from the instructor. Keep local.
docs/BMEN600*.pdf

# Test layouts of the paper (PDFs and page images, rebuilt by docs/paper/build/test_layout/build_layout.py). Keep local.
docs/paper/build/

# Teammates working drafts of the paper. Keep local.
docs/\[Working draft\]*

# Keep the paper build scripts, ignore what they produce.
!docs/paper/build/
docs/paper/build/*
!docs/paper/build/*.py
